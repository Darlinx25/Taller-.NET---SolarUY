@model SolarUY.Models.HistoricoViewModel
@using SolarUY.Domain.Enums
@{
    ViewData["Title"] = "Histórico de generación";
}

<h1 class="h3 mb-4">Histórico de generación</h1>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Filtro.TipoEntidad" for="Filtro_TipoEntidad" class="form-label"></label>
            <select asp-for="Filtro.TipoEntidad"
                    asp-items="Html.GetEnumSelectList<TipoEntidadHistorico>()"
                    class="form-select"
                    id="Filtro_TipoEntidad"></select>
        </div>

        <div class="col-md-3">
            <label asp-for="Filtro.EntidadId" for="Filtro_EntidadId" class="form-label"></label>
            <select asp-for="Filtro.EntidadId" class="form-select" id="Filtro_EntidadId">
                <option value="">Todas</option>
                @foreach (var parque in Model.Opciones.Parques)
                {
                    <option value="@parque.Id" data-tipo="Parque" selected="@(Model.Filtro.EntidadId == parque.Id)">@parque.Nombre</option>
                }
                @foreach (var nodo in Model.Opciones.Nodos)
                {
                    <option value="@nodo.Id" data-tipo="Nodo" selected="@(Model.Filtro.EntidadId == nodo.Id)">@nodo.Nombre</option>
                }
                @foreach (var panel in Model.Opciones.Paneles)
                {
                    <option value="@panel.Id" data-tipo="Panel" selected="@(Model.Filtro.EntidadId == panel.Id)">@panel.Nombre</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label asp-for="Filtro.Desde" class="form-label"></label>
            <input asp-for="Filtro.Desde" type="date" class="form-control" />
            <span asp-validation-for="Filtro.Desde" class="text-danger"></span>
        </div>

        <div class="col-md-2">
            <label asp-for="Filtro.Hasta" class="form-label"></label>
            <input asp-for="Filtro.Hasta" type="date" class="form-control" />
            <span asp-validation-for="Filtro.Hasta" class="text-danger"></span>
        </div>

        <div class="col-md-2">
            <label asp-for="Filtro.Agrupacion" class="form-label"></label>
            <select asp-for="Filtro.Agrupacion"
                    asp-items="Html.GetEnumSelectList<AgrupacionHistorico>()"
                    class="form-select"></select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Energía total</div>
                <div class="fs-4 fw-semibold">@Model.Resultado.EnergiaTotalKWh.ToString("N2") kWh</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Potencia promedio</div>
                <div class="fs-4 fw-semibold">@Model.Resultado.PotenciaPromedioW.ToString("N2") W</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Potencia máxima</div>
                <div class="fs-4 fw-semibold">@Model.Resultado.PotenciaMaximaW.ToString("N2") W</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Fallas</div>
                <div class="fs-4 fw-semibold">@Model.Resultado.Fallas</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Energía por período</div>
    <div class="card-body">
        <canvas id="grafico-historico" height="120"></canvas>
    </div>
</div>

@if (Model.Resultado.Resumenes.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No hay datos para los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Período</th>
                    <th scope="col">Entidad</th>
                    <th scope="col" class="text-end">Energía (kWh)</th>
                    <th scope="col" class="text-end">Potencia promedio (W)</th>
                    <th scope="col" class="text-end">Potencia máxima (W)</th>
                    <th scope="col" class="text-end">Fallas</th>
                    <th scope="col">Último estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resumen in Model.Resultado.Resumenes)
                {
                    <tr>
                        <td>@resumen.Periodo</td>
                        <td>@resumen.EntidadNombre</td>
                        <td class="text-end">@resumen.EnergiaKWh.ToString("N2")</td>
                        <td class="text-end">@resumen.PotenciaPromedioW.ToString("N2")</td>
                        <td class="text-end">@resumen.PotenciaMaximaW.ToString("N2")</td>
                        <td class="text-end">@resumen.Fallas</td>
                        <td>@resumen.UltimoEstado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script id="datos-grafico" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Resultado.PuntosGrafico))</script>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/historico.js" asp-append-version="true"></script>
}
