@model SolarUY.Application.Dtos.DashboardTelemetriaViewDto
@{
    ViewData["Title"] = "Dashboard de telemetría en vivo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3">Dashboard de telemetría en vivo</h1>
    </div>

    <div id="dashboardLive">
        <partial name="_DashboardContenido" model="Model" />
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        integrity="sha384-mU1xC5yC2LldSW74Rj1Ax8wPiLw/28V5eh51uKJMlBbRVsOtUYd4xyzNsgIAJARB"
        crossorigin="anonymous"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/telemetria')
        .withAutomaticReconnect()
        .build();

    const contenidoUrl = '@Url.Action("Contenido", "Dashboard")';

    connection.on('ActualizarTelemetria', async function () {
        try {
            const response = await fetch(contenidoUrl, { credentials: 'same-origin' });
            if (!response.ok) {
                throw new Error(`No se pudo actualizar el dashboard (${response.status}).`);
            }

            document.getElementById('dashboardLive').innerHTML = await response.text();
        } catch (err) {
            console.error(err.toString());
        }
    });

    connection.start().catch(function (err) {
        console.error(err.toString());
    });
</script>
