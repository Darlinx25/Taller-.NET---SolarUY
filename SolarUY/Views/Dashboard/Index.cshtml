@model SolarUY.Application.Dtos.DashboardPaginaDto
@{
    ViewData["Title"] = "Dashboard de telemetría en vivo";
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Dashboard" }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Dashboard de telemetría en vivo</h1>
        <p class="app-page-subtitle">Los datos se actualizan automáticamente al recibir nueva telemetría.</p>
    </div>
    <span class="badge text-bg-success align-self-start">En vivo</span>
</div>

<div id="dashboardRoot"
     data-contenido-url="@Url.Action("Contenido", "Dashboard")"
     data-tendencia-url="@Url.Action("Tendencia", "Dashboard")"
     data-simulacion-url="@Url.Content("~/api/control-simulacion/simulacion-forzada")"
     data-falla-url="@Url.Content("~/api/control-simulacion/falla")">
    <div id="controlMensaje" class="alert d-none" role="status"></div>

    <div class="dashboard-live-shell">
        <div id="dashboardLive">
            <partial name="_DashboardContenido" model="Model.Dashboard" />
        </div>

        <div class="dashboard-block-half dashboard-trend-chart">
            <div class="card h-100">
                <div class="card-header">Energía diaria (últimos 7 días)</div>
                <div class="card-body">
                    <div id="contenedorGraficoTendencia" class="@(Model.Tendencia.TieneDatos ? string.Empty : "d-none")">
                        <div class="dashboard-chart-container dashboard-chart-container-lg">
                            <canvas id="grafico-tendencia"></canvas>
                        </div>
                    </div>
                    <div id="mensajeTendencia"
                         class="app-empty-state text-center py-4 @(Model.Tendencia.TieneDatos ? "d-none" : string.Empty)">
                        Sin datos históricos para los últimos 7 días.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script id="datos-tendencia" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tendencia.Puntos))</script>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
