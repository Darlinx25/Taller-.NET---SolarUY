@model SolarUY.Application.Dtos.TareaMantenimientoDetalleDto
@{
    ViewData["Title"] = "Eliminar tarea";

    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = Model.ParqueSolarNombre ?? "Parque solar", Url = Model.ParqueSolarId.HasValue ? Url.Action("Details", "ParquesSolares", new { id = Model.ParqueSolarId }) : null },
        new() { Texto = Model.NodoCodigo ?? "Nodo", Url = Model.NodoId.HasValue ? Url.Action("Details", "Nodos", new { id = Model.NodoId }) : null },
        new() { Texto = Model.PanelCodigoSerie ?? "Panel", Url = Url.Action("Details", "Paneles", new { id = Model.PanelId }) },
        new() { Texto = "Tareas", Url = Url.Action("Index", "TareasMantenimiento", new { panelId = Model.PanelId }) },
        new() { Texto = "Eliminar" }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Eliminar tarea de mantenimiento</h1>
        <p class="app-page-subtitle">Revisá la información antes de confirmar la baja.</p>
    </div>
</div>

<div class="alert alert-warning" role="alert">
    ¿Está seguro que desea eliminar esta tarea de mantenimiento? Esta acción es física y no se puede deshacer.
</div>

<div class="app-context-banner d-flex flex-wrap gap-3 align-items-center">
    <span><strong>Parque:</strong> @Model.ParqueSolarNombre</span>
    <span><strong>Nodo:</strong> @Model.NodoCodigo</span>
    <span><strong>Panel:</strong> @Model.PanelCodigoSerie</span>
</div>

<div class="card app-form-card border-danger">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.TipoTarea</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><partial name="_EstadoBadge" model="Model.Estado" /></dd>

            <dt class="col-sm-3">Asignado a</dt>
            <dd class="col-sm-9 mb-0">@Model.AsignadoA</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="app-action-bar">
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
            </div>
        </form>
    </div>
</div>
