@model SolarUY.Application.Dtos.CambiarEstadoTareaMantenimientoDto
@{
    var tarea = ViewBag.Tarea as SolarUY.Application.Dtos.TareaMantenimientoDetalleDto;
    ViewData["Title"] = "Cambiar estado";

    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") }
    };
    if (tarea is not null)
    {
        migas.Add(new() { Texto = tarea.ParqueSolarNombre ?? "Parque solar", Url = tarea.ParqueSolarId.HasValue ? Url.Action("Details", "ParquesSolares", new { id = tarea.ParqueSolarId }) : null });
        migas.Add(new() { Texto = tarea.NodoCodigo ?? "Nodo", Url = tarea.NodoId.HasValue ? Url.Action("Details", "Nodos", new { id = tarea.NodoId }) : null });
        migas.Add(new() { Texto = tarea.PanelCodigoSerie ?? "Panel", Url = Url.Action("Details", "Paneles", new { id = tarea.PanelId }) });
        migas.Add(new() { Texto = "Tareas", Url = Url.Action("Index", "TareasMantenimiento", new { panelId = tarea.PanelId }) });
        migas.Add(new() { Texto = "Detalle", Url = Url.Action("Details", "TareasMantenimiento", new { id = tarea.Id }) });
    }
    migas.Add(new() { Texto = "Cambiar estado" });
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Cambiar estado</h1>
        <p class="app-page-subtitle">@tarea?.TipoTarea</p>
    </div>
</div>

@if (tarea is not null)
{
    <div class="app-context-banner d-flex flex-wrap gap-3 align-items-center">
        <span><strong>Parque:</strong> @tarea.ParqueSolarNombre</span>
        <span><strong>Nodo:</strong> @tarea.NodoCodigo</span>
        <span><strong>Panel:</strong> @tarea.PanelCodigoSerie</span>
        <span><strong>Estado actual:</strong> <partial name="_EstadoBadge" model="tarea.Estado" /></span>
    </div>
}

<div class="card app-form-card">
    <div class="card-body">
        <form asp-action="CambiarEstado" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NuevoEstado" class="form-label"></label>
                    <select asp-for="NuevoEstado" class="form-select">
                        @if (tarea != null)
                        {
                            if (string.Equals(tarea.Estado, "Pendiente", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="EnProceso">EnProceso</option>
                                <option value="Cancelada">Cancelada</option>
                            }
                            else if (string.Equals(tarea.Estado, "EnProceso", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Completada">Completada</option>
                                <option value="Cancelada">Cancelada</option>
                            }
                        }
                        else
                        {
                            <option value="EnProceso">EnProceso</option>
                            <option value="Completada">Completada</option>
                            <option value="Cancelada">Cancelada</option>
                        }
                    </select>
                    <span asp-validation-for="NuevoEstado" class="text-danger"></span>
                </div>

                <div class="col-md-6" id="quienCompletaGroup">
                    <label asp-for="QuienCompleta" class="form-label"></label>
                    <input asp-for="QuienCompleta" class="form-control" placeholder="Persona que completa la tarea" />
                    <span asp-validation-for="QuienCompleta" class="text-danger"></span>
                </div>
            </div>

            <div class="app-action-bar">
                <button type="submit" class="btn btn-primary">Cambiar</button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleQuienCompleta() {
            var sel = document.getElementById('NuevoEstado');
            var grp = document.getElementById('quienCompletaGroup');
            if (!sel || !grp) return;
            grp.style.display = sel.value === 'Completada' ? 'block' : 'none';
        }
        document.addEventListener('DOMContentLoaded', function () {
            var sel = document.getElementById('NuevoEstado');
            if (sel) sel.addEventListener('change', toggleQuienCompleta);
            toggleQuienCompleta();
        });
    </script>
}
