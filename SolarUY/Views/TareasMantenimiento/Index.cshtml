@model IReadOnlyList<SolarUY.Application.Dtos.TareaMantenimientoDto>
@{
    var panel = ViewBag.Panel as SolarUY.Application.Dtos.PanelDetalleDto;
    ViewData["Title"] = "Tareas de mantenimiento";

    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") }
    };
    if (panel is not null)
    {
        migas.Add(new() { Texto = panel.ParqueSolarNombre ?? "Parque solar", Url = Url.Action("Details", "ParquesSolares", new { id = panel.ParqueSolarId }) });
        migas.Add(new() { Texto = panel.NodoCodigo, Url = Url.Action("Details", "Nodos", new { id = panel.NodoId }) });
        migas.Add(new() { Texto = panel.CodigoSerie, Url = Url.Action("Details", "Paneles", new { id = panel.Id }) });
    }
    migas.Add(new() { Texto = "Tareas" });
    var emptyState = new EmptyStateViewModel
    {
        Mensaje = "Este panel no tiene tareas de mantenimiento registradas.",
        TextoAccion = "Nueva tarea",
        UrlAccion = Url.Action("Create", "TareasMantenimiento", new { panelId = panel?.Id })
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Tareas de mantenimiento</h1>
        <p class="app-page-subtitle">@(panel is null ? "Panel" : $"Panel {panel.CodigoSerie}")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Create" asp-route-panelId="@panel?.Id">Nueva tarea</a>
        @if (panel is not null)
        {
            <a class="btn btn-secondary" asp-controller="Paneles" asp-action="Details" asp-route-id="@panel.Id">Volver al panel</a>
        }
    </div>
</div>

@if (panel is not null)
{
    <div class="app-context-banner d-flex flex-wrap gap-3 align-items-center">
        <span><strong>Parque:</strong> @panel.ParqueSolarNombre</span>
        <span><strong>Nodo:</strong> @panel.NodoCodigo</span>
        <span><strong>Panel:</strong> @panel.CodigoSerie</span>
    </div>
}

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="emptyState" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tipo de tarea</th>
                        <th>Estado</th>
                        <th>Asignado a</th>
                        <th>Asignación</th>
                        <th>Vencimiento</th>
                        <th>Inicio</th>
                        <th>Finalización</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var cerrada = string.Equals(item.Estado, "Completada", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(item.Estado, "Cancelada", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td class="fw-semibold">@item.TipoTarea</td>
                            <td><partial name="_EstadoBadge" model="item.Estado" /></td>
                            <td>@item.AsignadoA</td>
                            <td>@item.FechaAsignacion.ToString("yyyy-MM-dd")</td>
                            <td>@item.FechaVencimiento.ToString("yyyy-MM-dd")</td>
                            <td>@(item.FechaInicio == default ? "-" : item.FechaInicio.ToString("yyyy-MM-dd"))</td>
                            <td>@(item.FechaFinalizacion == default ? "-" : item.FechaFinalizacion.ToString("yyyy-MM-dd"))</td>
                            <td>
                                <div class="app-table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalle</a>
                                    @if (!cerrada)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-warning" asp-action="CambiarEstado" asp-route-id="@item.Id">Cambiar estado</a>
                                    }
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
