@model NodoDetalleViewModel
@{
    ViewData["Title"] = "Detalle del nodo";
    var nodo = Model.Nodo;
    var returnUrlParque = Url.Action("Details", "ParquesSolares", new { id = nodo.ParqueSolarId });
    var returnUrlNodo = Url.Action("Details", "Nodos", new { id = nodo.Id });
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = nodo.ParqueSolarNombre ?? "Parque solar", Url = returnUrlParque },
        new() { Texto = nodo.Codigo }
    };
    var emptyState = new EmptyStateViewModel
    {
        Mensaje = "Este nodo todavía no tiene paneles registrados.",
        TextoAccion = "Agregar panel",
        UrlAccion = Url.Action("Create", "Paneles", new { nodoId = nodo.Id, returnUrl = returnUrlNodo })
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">
            Nodo @nodo.Codigo
            <partial name="_EstadoBadge" model="nodo.Estado" />
        </h1>
        <p class="app-page-subtitle">@nodo.ParqueSolarNombre</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-success"
           asp-controller="Paneles" asp-action="Create"
           asp-route-nodoId="@nodo.Id"
           asp-route-returnUrl="@returnUrlNodo">Agregar panel</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@nodo.Id" asp-route-returnUrl="@returnUrlNodo">Editar</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@nodo.Id" asp-route-returnUrl="@returnUrlParque">Eliminar</a>
        <a class="btn btn-secondary" asp-controller="ParquesSolares" asp-action="Details" asp-route-id="@nodo.ParqueSolarId">Volver al parque</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">Inversor</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Marca</dt>
                    <dd class="col-sm-8">@(nodo.Inversor?.Marca ?? "-")</dd>
                    <dt class="col-sm-4">Modelo</dt>
                    <dd class="col-sm-8">@(nodo.Inversor?.Modelo ?? "-")</dd>
                    <dt class="col-sm-4">Número de serie</dt>
                    <dd class="col-sm-8">@(nodo.Inversor?.NumeroSerie ?? "-")</dd>
                    <dt class="col-sm-4">Potencia nominal</dt>
                    <dd class="col-sm-8 mb-0">@(nodo.Inversor?.PotenciaNominalkW?.ToString("0.00") ?? "-") kW</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="row g-3">
            <div class="col-sm-6">
                <div class="app-stat-card">
                    <div class="app-stat-label">Paneles</div>
                    <div class="app-stat-value">@Model.CantidadPaneles</div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="app-stat-card">
                    <div class="app-stat-label">Potencia instalada</div>
                    <div class="app-stat-value">@Model.PotenciaTotalWp.ToString("N0") Wp</div>
                </div>
            </div>
            <div class="col-12">
                <div class="app-stat-card">
                    <div class="app-stat-label">Descripción</div>
                    <div>@(string.IsNullOrWhiteSpace(nodo.Descripcion) ? "Sin descripción" : nodo.Descripcion)</div>
                    <div class="app-stat-label mt-2">Fecha de creación</div>
                    <div>@nodo.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h2 class="h5 mb-0">Paneles</h2>
    <a class="btn btn-sm btn-outline-success"
       asp-controller="Paneles" asp-action="Create"
       asp-route-nodoId="@nodo.Id"
       asp-route-returnUrl="@returnUrlNodo">Agregar panel</a>
</div>

@if (Model.Paneles.Count == 0)
{
    <partial name="_EmptyState" model="emptyState" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Código/Serie</th>
                        <th scope="col">Marca</th>
                        <th scope="col">Modelo</th>
                        <th scope="col" class="text-end">Potencia (Wp)</th>
                        <th scope="col">Fecha de alta</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var panel in Model.Paneles)
                    {
                        <tr>
                            <td class="fw-semibold">@panel.CodigoSerie</td>
                            <td>@panel.Marca</td>
                            <td>@panel.Modelo</td>
                            <td class="text-end">@panel.PotenciaWp.ToString("0.00")</td>
                            <td>@panel.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="app-table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Paneles" asp-action="Details" asp-route-id="@panel.Id">Detalle</a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Paneles" asp-action="Edit"
                                       asp-route-id="@panel.Id"
                                       asp-route-returnUrl="@returnUrlNodo">Editar</a>
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-controller="Paneles" asp-action="Delete"
                                       asp-route-id="@panel.Id"
                                       asp-route-returnUrl="@returnUrlNodo">Eliminar</a>
                                    <a class="btn btn-sm btn-outline-warning"
                                       asp-controller="TareasMantenimiento" asp-action="Index"
                                       asp-route-panelId="@panel.Id">Tareas</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
