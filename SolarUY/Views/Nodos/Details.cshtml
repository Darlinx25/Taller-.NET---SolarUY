@model SolarUY.Application.Dtos.NodoDetalleDto
@{
    ViewData["Title"] = "Detalle del nodo";
}

<h1 class="h3 mb-4">Detalle del nodo</h1>

<h2 class="h5">Nodo</h2>
<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Codigo</dd>
    <dt class="col-sm-3">Parque solar</dt>
    <dd class="col-sm-9">@Model.ParqueSolarNombre</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "-" : Model.Descripcion)</dd>
    <dt class="col-sm-3">Fecha de creación</dt>
    <dd class="col-sm-9">@Model.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<h2 class="h5 mt-4">Inversor</h2>
<dl class="row">
    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Inversor?.Marca</dd>
    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Inversor?.Modelo</dd>
    <dt class="col-sm-3">Número de serie</dt>
    <dd class="col-sm-9">@Model.Inversor?.NumeroSerie</dd>
    <dt class="col-sm-3">Potencia nominal (kW)</dt>
    <dd class="col-sm-9">@(Model.Inversor?.PotenciaNominalkW?.ToString("0.00") ?? "-")</dd>
</dl>

<div class="mt-4">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="btn btn-secondary" asp-action="Index" asp-route-parqueId="@Model.ParqueSolarId">Volver al listado</a>
</div>
