@model EditarParqueSolarDto
@{
    ViewData["Title"] = "Editar parque solar";
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = "Editar parque" }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Editar parque solar</h1>
        <p class="app-page-subtitle">Actualizá los datos del parque.</p>
    </div>
</div>

<div class="card app-form-card">
    <div class="card-body">
        <form asp-controller="ParquesSolares" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Parque Solar Manga" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Ubicacion" class="form-label"></label>
                    <input asp-for="Ubicacion" class="form-control" placeholder="Ej. Ruta 5 km 12, Canelones" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CapacidadEstimadaMW" class="form-label"></label>
                    <input asp-for="CapacidadEstimadaMW" class="form-control" step="0.01" placeholder="Ej. 25.50" />
                    <span asp-validation-for="CapacidadEstimadaMW" class="text-danger"></span>
                    <div class="form-text">Capacidad total estimada en megavatios (opcional).</div>
                </div>
            </div>

            <div class="app-action-bar">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
