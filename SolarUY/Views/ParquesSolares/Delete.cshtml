@model ParqueSolarDto
@{
    ViewData["Title"] = "Eliminar parque solar";
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = Model.Nombre }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Eliminar parque solar</h1>
        <p class="app-page-subtitle">Revisá la información antes de confirmar la baja.</p>
    </div>
</div>

<div class="card app-form-card border-danger">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            ¿Confirma que desea eliminar el siguiente parque solar? Esta acción es definitiva.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Ubicacion)</dt>
            <dd class="col-sm-9">@Model.Ubicacion</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CapacidadEstimadaMW)</dt>
            <dd class="col-sm-9 mb-0">@(Model.CapacidadEstimadaMW?.ToString("0.00") ?? "-")</dd>
        </dl>

        <form asp-controller="ParquesSolares" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="app-action-bar">
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>
