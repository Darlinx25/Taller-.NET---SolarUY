@model IReadOnlyList<ParqueSolarDto>
@{
    ViewData["Title"] = "Parques Solares";
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares" }
    };
    var emptyState = new EmptyStateViewModel
    {
        Mensaje = "Todavía no hay parques solares registrados.",
        TextoAccion = "Registrar parque solar",
        UrlAccion = Url.Action("Create", "ParquesSolares")
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Parques solares</h1>
        <p class="app-page-subtitle">Administrá tus parques y accedé a sus nodos y paneles.</p>
    </div>
    <a class="btn btn-primary" asp-controller="ParquesSolares" asp-action="Create">Registrar parque solar</a>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="emptyState" />
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var parque in Model)
        {
            <div class="col">
                <div class="card h-100 app-card-hover">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h2 class="h5 mb-1">@parque.Nombre</h2>
                                <p class="text-muted mb-0">@parque.Ubicacion</p>
                            </div>
                            <span class="badge text-bg-light">
                                @(parque.CapacidadEstimadaMW?.ToString("0.00") ?? "-") MW
                            </span>
                        </div>
                        <p class="small text-muted mb-0">
                            Alta: @parque.FechaCreacion.ToString("yyyy-MM-dd HH:mm")
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@parque.Id">Ver nodos</a>
                        <a class="btn btn-sm btn-outline-success"
                           asp-controller="Nodos" asp-action="Create"
                           asp-route-parqueId="@parque.Id"
                           asp-route-returnUrl="@Url.Action("Details", "ParquesSolares", new { id = parque.Id })">Agregar nodo</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@parque.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@parque.Id">Eliminar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
