@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Error" }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3 text-danger">Ocurrió un error</h1>
        <p class="app-page-subtitle">No pudimos procesar tu solicitud.</p>
    </div>
</div>

<div class="alert alert-danger" role="alert">
    Se produjo un error inesperado al procesar la solicitud. Si el problema persiste, contactá al administrador.
</div>

@if (Model.ShowRequestId)
{
    <div class="card app-form-card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Request ID</dt>
                <dd class="col-sm-9 mb-0"><code>@Model.RequestId</code></dd>
            </dl>
        </div>
    </div>
}

<div class="mt-3">
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
