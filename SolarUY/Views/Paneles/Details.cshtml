@model SolarUY.Application.Dtos.PanelDetalleDto
@{
    ViewData["Title"] = "Detalle del panel";
}

<h1 class="h3 mb-4">Detalle del panel</h1>

<h2 class="h5">Panel</h2>
<dl class="row">
    <dt class="col-sm-3">Código/Serie</dt>
    <dd class="col-sm-9">@Model.CodigoSerie</dd>
    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Marca</dd>
    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo</dd>
    <dt class="col-sm-3">Potencia (Wp)</dt>
    <dd class="col-sm-9">@Model.PotenciaWp.ToString("0.00")</dd>
    <dt class="col-sm-3">Fecha de instalación</dt>
    <dd class="col-sm-9">@(Model.FechaInstalacion?.ToString("yyyy-MM-dd") ?? "-")</dd>
    <dt class="col-sm-3">Observaciones</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "-" : Model.Observaciones)</dd>
    <dt class="col-sm-3">Fecha de alta</dt>
    <dd class="col-sm-9">@Model.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<h2 class="h5 mt-4">Ubicación</h2>
<dl class="row">
    <dt class="col-sm-3">Parque solar</dt>
    <dd class="col-sm-9">@Model.ParqueSolarNombre</dd>
    <dt class="col-sm-3">Nodo</dt>
    <dd class="col-sm-9">@Model.NodoCodigo</dd>
</dl>

<div class="mt-4">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="btn btn-secondary" asp-action="Index" asp-route-nodoId="@Model.NodoId">Volver al listado</a>
    <a class="btn btn-info text-white" asp-controller="Nodos" asp-action="Details" asp-route-id="@Model.NodoId">Volver al nodo</a>
</div>
