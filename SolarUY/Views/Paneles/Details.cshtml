@model SolarUY.Application.Dtos.PanelDetalleDto
@{
    ViewData["Title"] = "Detalle del panel";
    var returnUrlNodo = Url.Action("Details", "Nodos", new { id = Model.NodoId });
    var returnUrlParque = Url.Action("Details", "ParquesSolares", new { id = Model.ParqueSolarId });
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = Model.ParqueSolarNombre ?? "Parque solar", Url = returnUrlParque },
        new() { Texto = Model.NodoCodigo, Url = returnUrlNodo },
        new() { Texto = Model.CodigoSerie }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Panel @Model.CodigoSerie</h1>
        <p class="app-page-subtitle">Nodo @Model.NodoCodigo · @Model.ParqueSolarNombre</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Url.Action("Details", "Paneles", new { id = Model.Id })">Editar</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@returnUrlNodo">Eliminar</a>
        <a class="btn btn-warning"
           asp-controller="TareasMantenimiento" asp-action="Index"
           asp-route-panelId="@Model.Id">Tareas</a>
        <a class="btn btn-secondary" asp-controller="Nodos" asp-action="Details" asp-route-id="@Model.NodoId">Volver al nodo</a>
    </div>
</div>

<div class="card app-form-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Código/Serie</dt>
            <dd class="col-sm-9">@Model.CodigoSerie</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.Marca</dd>

            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.Modelo</dd>

            <dt class="col-sm-3">Potencia</dt>
            <dd class="col-sm-9">@Model.PotenciaWp.ToString("0.00") Wp</dd>

            <dt class="col-sm-3">Fecha de instalación</dt>
            <dd class="col-sm-9">@(Model.FechaInstalacion?.ToString("yyyy-MM-dd") ?? "-")</dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "-" : Model.Observaciones)</dd>

            <dt class="col-sm-3">Fecha de alta</dt>
            <dd class="col-sm-9 mb-0">@Model.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
