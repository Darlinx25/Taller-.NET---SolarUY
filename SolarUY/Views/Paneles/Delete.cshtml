@model SolarUY.Application.Dtos.PanelDetalleDto
@{
    ViewData["Title"] = "Eliminar panel";
}

<h1 class="h3 mb-4">Eliminar panel</h1>

<div class="alert alert-warning" role="alert">
    ¿Confirma que desea eliminar el siguiente panel? Esta acción es definitiva.
</div>

<dl class="row">
    <dt class="col-sm-3">Código/Serie</dt>
    <dd class="col-sm-9">@Model.CodigoSerie</dd>
    <dt class="col-sm-3">Marca</dt>
    <dd class="col-sm-9">@Model.Marca</dd>
    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo</dd>
    <dt class="col-sm-3">Potencia (Wp)</dt>
    <dd class="col-sm-9">@Model.PotenciaWp.ToString("0.00")</dd>
    <dt class="col-sm-3">Parque solar</dt>
    <dd class="col-sm-9">@Model.ParqueSolarNombre</dd>
    <dt class="col-sm-3">Nodo</dt>
    <dd class="col-sm-9">@Model.NodoCodigo</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index" asp-route-nodoId="@Model.NodoId">Cancelar</a>
</form>
