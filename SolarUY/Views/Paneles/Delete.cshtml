@model SolarUY.Application.Dtos.PanelDetalleDto
@{
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = "Eliminar panel";
    var urlCancelar = string.IsNullOrWhiteSpace(returnUrl)
        ? Url.Action("Details", "Paneles", new { id = Model.Id })
        : returnUrl;
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = Model.ParqueSolarNombre ?? "Parque solar", Url = Url.Action("Details", "ParquesSolares", new { id = Model.ParqueSolarId }) },
        new() { Texto = Model.NodoCodigo, Url = Url.Action("Details", "Nodos", new { id = Model.NodoId }) },
        new() { Texto = Model.CodigoSerie }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Eliminar panel</h1>
        <p class="app-page-subtitle">Revisá la información antes de confirmar la baja.</p>
    </div>
</div>

<div class="card app-form-card border-danger">
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            ¿Está seguro de que desea eliminar este panel? Esta acción es definitiva.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Código/Serie</dt>
            <dd class="col-sm-9">@Model.CodigoSerie</dd>
            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.Marca</dd>
            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.Modelo</dd>
            <dt class="col-sm-3">Potencia</dt>
            <dd class="col-sm-9 mb-0">@Model.PotenciaWp.ToString("0.00") Wp</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="app-action-bar">
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a class="btn btn-secondary" href="@urlCancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>
