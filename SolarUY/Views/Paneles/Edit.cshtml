@model SolarUY.Application.Dtos.EditarPanelDto
@{
    var panel = ViewBag.Panel as SolarUY.Application.Dtos.PanelDetalleDto;
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = "Editar panel";
    var urlCancelar = string.IsNullOrWhiteSpace(returnUrl)
        ? Url.Action("Details", "Paneles", new { id = Model.Id })
        : returnUrl;
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = panel?.ParqueSolarNombre ?? "Parque solar", Url = Url.Action("Details", "ParquesSolares", new { id = panel?.ParqueSolarId }) },
        new() { Texto = panel?.NodoCodigo ?? "Nodo", Url = Url.Action("Details", "Nodos", new { id = Model.NodoId }) },
        new() { Texto = "Editar panel" }
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Editar panel</h1>
        <p class="app-page-subtitle">@panel?.CodigoSerie</p>
    </div>
</div>

<div class="card app-form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="NodoId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h5">Datos del panel</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="CodigoSerie" class="form-label"></label>
                    <input asp-for="CodigoSerie" class="form-control" />
                    <span asp-validation-for="CodigoSerie" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PotenciaWp" class="form-label"></label>
                    <input asp-for="PotenciaWp" class="form-control" />
                    <span asp-validation-for="PotenciaWp" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Marca" class="form-label"></label>
                    <input asp-for="Marca" class="form-control" />
                    <span asp-validation-for="Marca" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Modelo" class="form-label"></label>
                    <input asp-for="Modelo" class="form-control" />
                    <span asp-validation-for="Modelo" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h5">Instalación y observaciones</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FechaInstalacion" class="form-label"></label>
                    <input asp-for="FechaInstalacion" class="form-control" type="date" />
                    <span asp-validation-for="FechaInstalacion" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
            </div>

            <div class="app-action-bar">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a class="btn btn-secondary" href="@urlCancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
