@model IReadOnlyList<SolarUY.Application.Dtos.PanelDto>
@{
    var nodo = ViewBag.Nodo as SolarUY.Application.Dtos.NodoDetalleDto;
    ViewData["Title"] = "Paneles";
}

<h1 class="h3 mb-3">Paneles - @nodo?.Codigo</h1>

@if (nodo is not null)
{
    <p class="text-muted">Parque solar: @nodo.ParqueSolarNombre</p>
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create" asp-route-nodoId="@nodo?.Id">Nuevo panel</a>
    <a class="btn btn-secondary" asp-controller="Nodos" asp-action="Details" asp-route-id="@nodo?.Id">Volver al nodo</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No hay paneles registrados para este nodo.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Código/Serie</th>
                <th scope="col">Marca</th>
                <th scope="col">Modelo</th>
                <th scope="col">Potencia (Wp)</th>
                <th scope="col">Fecha de alta</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var panel in Model)
            {
                <tr>
                    <td>@panel.CodigoSerie</td>
                    <td>@panel.Marca</td>
                    <td>@panel.Modelo</td>
                    <td>@panel.PotenciaWp.ToString("0.00")</td>
                    <td>@panel.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@panel.Id">Detalle</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@panel.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@panel.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
