@model IReadOnlyList<SolarUY.Application.Dtos.PanelDto>
@{
    var nodo = ViewBag.Nodo as SolarUY.Application.Dtos.NodoDto;
    ViewData["Title"] = "Paneles";
    var returnUrlNodo = nodo is null ? null : Url.Action("Details", "Nodos", new { id = nodo.Id });
    var returnUrlListado = Url.Action("Index", "Paneles", new { nodoId = nodo?.Id });
    var migas = new List<BreadcrumbItem>
    {
        new() { Texto = "Inicio", Url = Url.Action("Index", "Home") },
        new() { Texto = "Parques solares", Url = Url.Action("Index", "ParquesSolares") },
        new() { Texto = nodo?.Codigo ?? "Nodo", Url = returnUrlNodo },
        new() { Texto = "Paneles" }
    };
    var emptyState = new EmptyStateViewModel
    {
        Mensaje = "Este nodo todavía no tiene paneles registrados.",
        TextoAccion = "Agregar panel",
        UrlAccion = Url.Action("Create", "Paneles", new { nodoId = nodo?.Id, returnUrl = returnUrlNodo })
    };
}

<partial name="_Breadcrumbs" model="migas" />

<div class="app-page-header">
    <div>
        <h1 class="h3">Paneles</h1>
        <p class="app-page-subtitle">Nodo @nodo?.Codigo</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary"
           asp-action="Create"
           asp-route-nodoId="@nodo?.Id"
           asp-route-returnUrl="@returnUrlNodo">Agregar panel</a>
        <a class="btn btn-secondary" asp-controller="Nodos" asp-action="Details" asp-route-id="@nodo?.Id">Volver al nodo</a>
    </div>
</div>

@if (!Model.Any())
{
    <partial name="_EmptyState" model="emptyState" />
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Código/Serie</th>
                        <th scope="col">Marca</th>
                        <th scope="col">Modelo</th>
                        <th scope="col" class="text-end">Potencia (Wp)</th>
                        <th scope="col">Instalación</th>
                        <th scope="col">Alta</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CodigoSerie</td>
                            <td>@item.Marca</td>
                            <td>@item.Modelo</td>
                            <td class="text-end">@item.PotenciaWp.ToString("0.00")</td>
                            <td>@(item.FechaInstalacion?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@item.FechaCreacion.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="app-table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalle</a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit" asp-route-id="@item.Id"
                                       asp-route-returnUrl="@returnUrlListado">Editar</a>
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Delete" asp-route-id="@item.Id"
                                       asp-route-returnUrl="@returnUrlListado">Eliminar</a>
                                    <a class="btn btn-sm btn-outline-warning"
                                       asp-controller="TareasMantenimiento" asp-action="Index"
                                       asp-route-panelId="@item.Id">Tareas</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
