# Copiá este archivo a .env (queda fuera de git) y ajustá lo que necesites.
#
#   cp .env.example .env
#
# Documentación completa en DESARROLLO.md

# --- MySQL 8.4 (stack de runtime) -------------------------------------------------
# Son credenciales de desarrollo local. El puerto se publica solo en 127.0.0.1,
# por lo que la base no es alcanzable desde la red.
MYSQL_ROOT_PASSWORD=SolarUY.Local2026
MYSQL_APP_USER=solaruy
MYSQL_APP_PASSWORD=SolarUY.Local2026
MYSQL_DATABASE=SolarUY
MYSQL_PORT=3307

# --- Simulación interna (mock del inversor) ---------------------------------------
# API key compartida entre app y simulador. Es OPCIONAL: si no la definis, docker-compose.yml usa
# este mismo valor por defecto (solo desarrollo local). Descomentala para cambiarla.
# SIMULACION_API_KEY=SolarUY.Local2026

# Fallas del mock, por panel y por lectura (una cada 5 s), entre 0 y 1. Son OPCIONALES:
# - SIMULADOR_PROBABILIDAD_FALLA: probabilidad de que falle un panel operativo (0.20 por defecto). Ponela en 0 para no tener fallas.
# - SIMULADOR_PROBABILIDAD_RECUPERACION: probabilidad de que un panel en falla se recupere (0.40 por defecto);
#   una falla dura en promedio 1 / probabilidad lecturas (2,5 lecturas, unos 12 s).
# SIMULADOR_PROBABILIDAD_FALLA=0.20
# SIMULADOR_PROBABILIDAD_RECUPERACION=0.40

# --- Keycloak (proveedor OIDC local) ----------------------------------------------
# Usuario administrador de la consola de Keycloak (http://localhost:8081/admin).
# Las credenciales de los usuarios de prueba (admin@solaruy.uy y operador@solaruy.uy)
# se importan desde docker/keycloak/realm-solaruy.json y son solo para desarrollo.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=SolarUY.Local2026
KEYCLOAK_PORT=8081
OIDC_CLIENT_SECRET=solaruy-app-secret

# --- SonarQube (stack de calidad) -------------------------------------------------
# El token es personal de cada máquina: se genera después del primer arranque
# (ver ControlCalidad/SonarQube/README.md). Si queda vacío, analizar.sh lo avisa.
SONAR_TOKEN=
SONAR_PROJECT_KEY=SolarUY
SONAR_HOST_URL=http://localhost:9000
SONAR_PORT=9000

# --- Permisos de archivos (solo Linux; en Mac/Windows Docker Desktop se ignoran) ---
LOCAL_UID=1000
LOCAL_GID=1000

# Alta Disponibilidad
APP_REPLICAS=2
APP_PORT=5080
